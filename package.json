{
  "name": "sms-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sms-worker --local",
    "db:migrate:remote": "wrangler d1 migrations apply sms-worker --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "miniflare": {
      "sharp": "^0.35.5"
    }
  }
}
