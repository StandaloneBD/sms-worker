{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sms-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    // Unsampled: logs are per batch, not per recipient, and the error/warn
    // lines are what answers "did this OTP go out?".
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Custom domain; the zone must exist on this Cloudflare account.
  "routes": [{ "pattern": "sms.shihabmridha.com", "custom_domain": true }],
  // Served only on the custom domain: workers.dev and per-version Preview
  // URLs would be extra public hostnames for the admin UI and API that skip
  // any zone-level WAF, Access, or rate-limit rules on that domain.
  "workers_dev": false,
  "preview_urls": false,
  // Static files (admin scripts, favicon) are served by Workers Static Assets
  // before the Worker runs, so they don't count as Worker requests. Any path
  // without a matching file falls through to the Worker (not_found_handling
  // defaults to "none"). Response headers for them live in public/_headers.
  "assets": { "directory": "./public" },
  "vars": {
    "FAKE_SMS": "false",
    // Comma-separated browser origins allowed to call /v1 (CORS), or "*" for
    // any. Empty disables CORS. The API is server-to-server; only list
    // origins that genuinely call it from a browser, since any key used
    // there is readable by that page's visitors.
    "CORS_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sms-worker",
      "database_id": "42a92c76-6bb8-497f-8c8c-6e1c5c365983",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0745e357ac8a4cf3928baa67142d8bd9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYLOADS",
      "bucket_name": "sms-worker"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SMS_QUEUE", "queue": "sms-worker-job" }],
    // The consumer routes by name: a queue whose name ends in "-dlq" is the
    // dead-letter queue, every other queue is chunk processing — keep that
    // suffix when renaming queues per environment.
    "consumers": [
      {
        "queue": "sms-worker-job",
        // Workers Free allows 50 D1 queries per invocation; one chunk (250
        // recipients ≈ 25 batched inserts) per invocation stays under it.
        "max_batch_size": 1,
        "max_retries": 5,
        // Caps parallel chunk sends: protects provider rate limits and keeps
        // D1 (single writer) from returning "overloaded" mid-chunk, which
        // would force a redelivery. ~5 × 250 recipients every few seconds.
        "max_concurrency": 5,
        "dead_letter_queue": "sms-worker-dlq"
      },
      {
        "queue": "sms-worker-dlq",
        // Also 1: recording one dead-lettered chunk costs ~30 D1 queries
        // (history inserts + finalize), and Workers Free caps an invocation
        // at 50 — ten DLQ messages per batch would blow that budget.
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  },
  "ratelimits": [
    // Per App, on POST /v1/sms/send and /v1/sms/jobs. Bounds a runaway
    // client; the per-App daily recipient quota (Admin → Apps) bounds spend.
    { "name": "SEND_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // Per client IP, on admin login attempts.
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Every 15 minutes: re-enqueue/fail stalled chunks, then a bounded slice of
  // the retention purge (history, finished jobs, idempotency keys, usage).
  "triggers": { "crons": ["*/15 * * * *"] }
}
